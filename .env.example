# Copy to .env on the server. Never commit .env.
# Private mode starts without these. Public mode refuses to start unless
# SIGNING_SECRET is a long random value (at least 32 characters).

PORT=3000
SERVER_MODE=private
PUBLIC_DEPLOY=false

# Long random strings. Do not reuse the old built-in master key.
MASTER_KEY=
SIGNING_SECRET=
SHUTDOWN_KEY=

# Mail. The sender and the admin inbox are different accounts.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAILS=
DAILY_REPORT_EMAIL=
ERROR_EMAIL_RECIPIENT=

# Optional public site
PUBLIC_URL=
SHARE_PUBLIC_KEY=
FRANCHISE_MANAGER_EMAILS=

# Student quick loan. Turnstile stays off when these are empty.
QUICK_LOAN_MIN_AMOUNT=50
QUICK_LOAN_MAX_AMOUNT=50000
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional
DAILY_REPORT_TIME=08:00
DAILY_REPORT_TIMEZONE=Africa/Lusaka
DB_MODE=json

# PRYME LOG license. Required on a live server. Login fails closed when the
# id or secret is missing. The validate URL defaults to the live PRYME LOG API.
# Never commit the secret.
PRYMELOG_LICENSE_ID=
PRYMELOG_LICENSE_SECRET=
PRYMELOG_VALIDATE_URL=https://pryme-log.vercel.app/api/license/validate

# Leave STORAGE unset (or local) on the shop PC. Set supabase only on Vercel.
STORAGE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
