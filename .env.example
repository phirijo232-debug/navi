# Copy to .env and fill in real values. Do not commit .env.

# Outgoing mail.
# MAIL_MODE=auto (default) sends through SMTP when credentials exist, and
# writes a local preview log when they do not.
# MAIL_MODE=smtp refuses to send unless credentials are set.
# MAIL_MODE=preview always writes logs/mail-preview.log and never contacts SMTP.
MAIL_MODE=auto

# SMTP. GMAIL_USER and GMAIL_APP_PASSWORD are the existing sender aliases.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Aliases used by the current Gmail sender. SMTP_USER / SMTP_PASS win when both are set.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Who receives admin reports, breakage alerts, and daily loan mail.
# These are not the sender. Do not put the sender address here.
ADMIN_EMAILS=
ADMIN_EMAIL=
ERROR_EMAIL_RECIPIENT=
DAILY_REPORT_EMAIL=
DAILY_REPORT_TIME=23:59
DAILY_REPORT_TIMEZONE=Africa/Lusaka

# Optional server settings.
PORT=3000
DEFAULT_STORE_ID=buraza
MASTER_KEY=
SHUTDOWN_KEY=
DB_MODE=json
