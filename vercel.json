{
  "redirects": [
    { "source": "/admin.html", "destination": "/admin", "permanent": false },
    { "source": "/login.html", "destination": "/login", "permanent": false },
    { "source": "/signin.html", "destination": "/login", "permanent": false },
    { "source": "/dashboard.html", "destination": "/admin", "permanent": false },
    { "source": "/dashboard", "destination": "/admin", "permanent": false },
    { "source": "/quick-screen", "destination": "/", "permanent": false },
    { "source": "/quick-screen.html", "destination": "/", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": false },
    { "source": "/user.html", "destination": "/account", "permanent": false },
    { "source": "/signup.html", "destination": "/signup", "permanent": false },
    { "source": "/forgot-password.html", "destination": "/forgot-password", "permanent": false }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/admin", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/kidneys", "schedule": "20 4 * * *" },
    { "path": "/api/cron/grace", "schedule": "5 22 * * *" },
    { "path": "/api/cron/notifications", "schedule": "58 21 * * *" },
    { "path": "/api/cron/daily-report", "schedule": "0 6 * * *" },
    { "path": "/api/cron/payments", "schedule": "59 21 * * *" }
  ]
}
